# ==========================================
# FOODBRIDGE 2.0 ENVIRONMENT CONFIGURATION
# ==========================================

# ─── BACKEND ENVIRONMENT VARIABLES (Render / Railway / Server) ───
# MongoDB Atlas connection string (replace with your credentials & cluster URL)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/foodbridge?retryWrites=true&w=majority

# Strong random secret for signing JWT tokens
JWT_SECRET=your_super_strong_production_secret_key_here

# Port for the Express server (Hosting providers set this automatically)
PORT=5000

# Environment mode ('production' or 'development')
NODE_ENV=production

# Allowed Frontend URL(s) for CORS (comma-separated or '*' for all)
# Example: https://foodbridge.vercel.app,https://foodbridge.netlify.app
CLIENT_URL=https://your-frontend.vercel.app


# ─── FRONTEND ENVIRONMENT VARIABLES (Vercel / Netlify) ───────────
# Deployed Backend API Base URL
# Example: https://foodbridge-api.onrender.com
# Leave empty for local development to use Vite's proxy (/api)
VITE_API_BASE_URL=https://your-backend-api.onrender.com
